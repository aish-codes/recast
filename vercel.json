{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.1",
      "memory": 1024,
      "maxDuration": 180
    }
  },
  "rewrites": [
    { "source": "/api/py/:path*", "destination": "/api/index" }
  ]
}
